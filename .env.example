# ─── Jira Integration (optional) ───────────────────────────────────────────────
# These are entered by the user directly in the UI, so no server-side env vars
# are strictly required. If you want to pre-fill them for your own deploy,
# add them here and expose them via NEXT_PUBLIC_ prefix.

# NEXT_PUBLIC_JIRA_DOMAIN=your-company.atlassian.net
# NEXT_PUBLIC_JIRA_PROJECT_KEY=PROJ
